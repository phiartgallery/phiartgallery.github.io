<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="{{ site.name }} — home">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="2.2"/>
            <ellipse cx="20" cy="20" rx="7.4" ry="9.4" stroke="currentColor" stroke-width="2.4"/>
            <line x1="20" y1="6.5" x2="20" y2="33.5" stroke="currentColor" stroke-width="2.4"/>
          </svg>
        </span>
        <span>Phi Gallery</span>
      </a>
      {# NAP block — identical name/address/phone string sitewide for local SEO. #}
      <address class="nap">
        <strong>{{ settings.name }}</strong>
        {{ settings.address.street }}<br>
        {{ settings.address.city }}, {{ settings.address.region }} {{ settings.address.postalCode }}<br>
        {%- if settings.phone %}<a href="tel:{{ settings.phone | replace(r/[^0-9+]/g, '') }}">{{ settings.phone }}</a><br>{% endif %}
        <a href="mailto:{{ settings.email }}">{{ settings.email }}</a>
      </address>
    </div>

    <div class="footer-col">
      <h3>Visit</h3>
      <ul>
        <li><a href="/visit/">Hours &amp; directions</a></li>
        <li><a href="https://www.google.com/maps/dir/?api=1&destination={{ (settings.address.street + ', ' + settings.address.city + ', ' + settings.address.region + ' ' + settings.address.postalCode) | urlencode }}" rel="noopener" data-analytics="directions">Get directions</a></li>
        <li><a href="/events/">Upcoming events</a></li>
        <li><a href="/press/">Press kit</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Connect</h3>
      <ul>
        {%- for item in nav.footer %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        {%- if site.instagramUrl %}<li><a href="{{ site.instagramUrl }}" rel="me noopener" data-analytics="instagram">Instagram</a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {{ page.date | year }} {{ settings.name }} · Built by artists, for artists in the North Country.</p>
    <div class="social-links">
      {%- if site.instagramUrl %}
      <a href="{{ site.instagramUrl }}" rel="me noopener" aria-label="Phi Gallery on Instagram" data-analytics="instagram">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.4 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.52.01-4.76.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7-.06 1.24-.07 1.6-.07 4.76s.01 3.52.07 4.76c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.6.07 4.76.07s3.52-.01 4.76-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.6.07-4.76s-.01-3.52-.07-4.76c-.04-.9-.19-1.38-.32-1.7a2.9 2.9 0 0 0-.68-1.06 2.9 2.9 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.52 4.01 15.15 4 12 4Zm0 3.05A4.95 4.95 0 1 1 12 16.95 4.95 4.95 0 0 1 12 7.05Zm0 1.8a3.15 3.15 0 1 0 0 6.3 3.15 3.15 0 0 0 0-6.3Zm5.15-.66a1.16 1.16 0 1 1 0 2.32 1.16 1.16 0 0 1 0-2.32Z"/></svg>
      </a>
      {%- endif %}
    </div>
  </div>
</footer>
